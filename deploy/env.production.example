# 生产环境配置 —— 在服务器上复制为 /data/sizheng2/teaching_model_service/.env.production
# 并执行 chmod 600 .env.production
# ★ ZHIPU_API_KEY 必填

# ---- 资源 API (9001) ----
TEACHING_RESOURCE_DIR=/data/sizheng2/json_output/PEP8U_PHYSICS
RESOURCE_API_KEYS=local-resource-key
RESOURCE_API_AUTH_DISABLED=false

# ---- 模型 API (9000) ----
RESOURCE_SERVICE_URL=http://127.0.0.1:9001
RESOURCE_SERVICE_API_KEY=local-resource-key
# 对外(合作方)调用用的 Bearer Key,沿用旧环境的值;如需更换记得和对方同步
TEACHING_API_KEYS=chengyanyuan
MODEL_API_AUTH_DISABLED=false

# ---- 智谱模型后端 ----
MODEL_BACKEND=zhipu
ZHIPU_MODEL=glm-5.2
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ★ 必填:智谱控制台生成的 API Key
ZHIPU_API_KEY=
MODEL_TIMEOUT=300

# ---- CORS ----
CORS_ALLOW_ORIGINS=*
