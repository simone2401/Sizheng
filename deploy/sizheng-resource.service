# 资源 API —— 开机自启、崩溃自动拉起
# 安装位置: /etc/systemd/system/sizheng-resource.service

[Unit]
Description=Sizheng Resource API (uvicorn :9001)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/data/sizheng2/teaching_model_service
EnvironmentFile=/data/sizheng2/teaching_model_service/.env.production
ExecStart=/data/sizheng2/teaching_model_service/.venv/bin/python -m uvicorn app.resource_api.main:app --host 127.0.0.1 --port 9001
Restart=always
RestartSec=3
StandardOutput=append:/data/sizheng2/teaching_model_service/logs/resource.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
